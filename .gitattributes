* text=auto eol=lf

# Source files
*.c text eol=lf
*.h text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Nasdaq Trader source snapshots and CSV exports use canonical CRLF records.
data/nasdaq_symbol_directory/*.csv text eol=crlf
data/nasdaq_symbol_directory/raw/*.txt text eol=crlf

# Binaries
*.o binary
*.a binary
*.so binary
*.dylib binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.pdf binary

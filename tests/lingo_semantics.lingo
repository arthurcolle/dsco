local l=require("lingo")
local t=l.types
local results=l.array{}
local function test(name, run)
  local ok,err=l.try(run)
  assert(ok, name..": "..tostring(err))
  results[#results+1]=name
end
local function rejects(run, text)
  local ok,err=l.try(run)
  assert(not ok, "expected failure")
  assert(tostring(err):find(text,1,true), tostring(err))
end
local w=l.world()
w:define("Node", {
  a=l.stored("integer", 1), b=l.stored("integer", 10), choose=l.stored("boolean", true),
  selected=l.derived("integer",function(s) if s.choose then return s.a else return s.b end end),
  twice=l.derived("integer",function(s) return s.selected*2 end),
  scaled=l.derived("integer",function(s,ctx,args) return s.a*args.factor end,{params={factor="integer"}}),
  fragile=l.derived("integer",function(s) assert(s.a>=0,"negative input");return s.a end),
  list=l.stored(t.list("integer"), {1,2}),
})
local x=w:new("Node","x")
test("lazy memoization",function()
  assert(w:why(x,"twice").state=="unread")
  assert(x.twice==2 and x.twice==2)
  assert(w:why(x,"twice").evaluations==1)
end)
test("inactive branch does not invalidate",function()
  w:set(x,"b",20);assert(w:why(x,"twice").state=="valid")
end)
test("transitive invalidation is lazy",function()
  w:set(x,"a",3);assert(w:why(x,"twice").state=="invalid")
  assert(w:why(x,"twice").evaluations==1 and x.twice==6)
end)
test("equal writes are noops",function()
  assert(not w:set(x,"a",3));assert(w:why(x,"twice").state=="valid")
end)
test("branch changes prune dependencies",function()
  w:set(x,"choose",false);assert(x.twice==40)
  local deps=w:why(x,"selected").dependencies
  assert(#deps==2 and deps[1].field=="b" and deps[2].field=="choose")
  w:set(x,"a",4);assert(w:why(x,"twice").state=="valid")
end)
test("parameterized cache identity",function()
  assert(w:get(x,"scaled",{factor=2})==8 and w:get(x,"scaled",{factor=3})==12)
  assert(w:get(x,"scaled",{factor=2})==8 and w:why(x,"scaled",{factor=2}).evaluations==1)
  w:set(x,"a",5);assert(w:get(x,"scaled",{factor=2})==10)
  rejects(function()w:get(x,"scaled",{factor="2"})end,"requires an exact integer")
end)
test("input and output copies",function()
  local input={4,5};w:set(x,"list",input);input[1]=88
  local output=x.list;output[1]=99;assert(x.list[1]==4)
end)
test("types and immutable refs",function()
  rejects(function()w:set(x,"a",1.5)end,"requires an exact integer")
  rejects(function()x.a=42 end,"reference fields cannot be assigned")
  rejects(function()w:set(x,"twice",42)end,"only stored")
end)
test("failure never serves stale successful value",function()
  assert(x.fragile==5);w:set(x,"a",-1)
  rejects(function()return x.fragile end,"negative input")
  assert(w:why(x,"fragile").state=="invalid")
  w:set(x,"a",6);assert(x.fragile==6)
end)
test("nested scenario restores outer and base",function()
  local base=x.twice
  w:scenario("outer",function(s)
    s:override(x,"selected",100);assert(x.twice==200)
    assert(#s:why(x,"selected").dependencies==0)
    s:override(x,"a",999);assert(x.twice==200)
    s:scenario("inner",function(inner)
      inner:override(x,"selected",500);assert(x.twice==1000)
      inner:restore(x,"selected");assert(x.twice==200)
    end)
    assert(x.twice==200);s:restore(x,"selected");assert(x.twice==base)
  end)
  assert(x.twice==base and x.a==6)
end)
test("scenario exception unwinds",function()
  rejects(function()w:scenario("error",function(s)s:override(x,"a",123);error("abort")end)end,"abort")
  assert(x.a==6)
end)
test("scenarios forbid actions and base writes",function()
  w:scenario("safe",function(s)
    rejects(function()s:set(x,"a",10)end,"base mutation")
    rejects(function()l.call("cwd",{})end,"inside a scenario")
  end)
end)
test("calculated values forbid effects",function()
  w:define("Bad",{value=l.derived("integer",function() l.call("cwd",{});return 1 end)})
  local b=w:new("Bad","bad");rejects(function()return b.value end,"inside a calculated value")
end)
test("calculated values forbid graph mutation",function()
  w:define("Mutation",{value=l.derived("integer",function()w:set(x,"a",9);return 1 end)})
  local b=w:new("Mutation","mut");rejects(function()return b.value end,"cannot mutate")
end)
test("dependency cycles fail",function()
  w:define("Cycle",{a=l.derived("integer",function(s)return s.b end),b=l.derived("integer",function(s)return s.a end)})
  local c=w:new("Cycle","cycle");rejects(function()return c.a end,"dependency cycle")
end)
test("object collection membership is tracked",function()
  w:define("Count",{value=l.derived("integer",function(_,ctx)return #ctx:objects("Node") end)})
  local count=w:new("Count","count");assert(count.value==1)
  w:new("Node","y");assert(w:why(count,"value").state=="invalid" and count.value==2)
end)
test("interfaces validate structural fields",function()
  w:interface("Named",{name="string"})
  rejects(function()w:define("Wrong",{name=l.stored("integer",0)},{implements={"Named"}})end,"interface mismatch")
  w:define("NamedNode",{name=l.stored("string","test")},{implements={"Named"},version="2"})
  assert(w:describe(w:new("NamedNode","named")).class_version=="2")
end)
test("cross-world reads fail inside calculations",function()
  local other=l.world();other:define("X",{v=l.stored("integer",1)})
  local o=other:new("X","o")
  w:define("Cross",{v=l.derived("integer",function()return o.v end)})
  local cross=w:new("Cross","cross");rejects(function()return cross.v end,"cross-world reads")
end)
test("null and empty arrays survive round trips",function()
  local d=l.decode('{"missing":null,"empty":[],"record":{},"zero":0}')
  assert(d.missing==l.null and l.encode(d.empty)=="[]" and l.encode(d.record)=="{}")
  assert(l.encode(l.array{})=="[]")
  local unicode=l.decode('{"x":"héllo\\u0000world"}')
  assert(l.decode(l.encode(unicode)).x==unicode.x)
  rejects(function()l.decode('{"x":1,"x":2}')end,"duplicate JSON key")
end)
test("JSON and namespace boundaries",function()
  rejects(function()l.decode("9007199254740993")end,"exact integer")
  rejects(function()l.encode({[1]=1,[3]=3})end,"record keys")
  local cycle={};cycle.self=cycle;rejects(function()l.encode(cycle)end,"structure limit")
  rejects(function()l.call=nil end,"read-only")
  assert(io==nil and os==nil and ffi==nil and debug==nil and package==nil and load==nil and pcall==nil)
  rejects(function()require("ffi")end,"available modules")
end)
test("inspect and cursor events",function()
  assert(w:describe(x).id=="x")
  local events=w:events(0,2);assert(#events.events==2 and events.next_cursor==2)
  assert(#w:events(events.next_cursor,2).events==2)
end)
test("catalog keys cannot collide with object IDs",function()
  local world=l.world()
  world:define("Item",{Item=l.derived("integer",function()return 9 end)})
  local obj=world:new("Item","@objects")
  world:objects("Item");assert(obj.Item==9)
end)
test("missing identity reads invalidate when an object appears",function()
  local world=l.world()
  world:define("Later",{v=l.stored("integer",1)})
  world:define("Watcher",{present=l.derived("boolean",function(_,ctx)
    local ok=l.try(function()return ctx:ref("later")end);return ok
  end)})
  local watcher=world:new("Watcher","watcher");assert(not watcher.present)
  world:new("Later","later");assert(watcher.present)
end)
test("inspection cannot become an untracked calculation input",function()
  w:define("Inspector",{v=l.derived("integer",function()return w:describe(x).revision end)})
  local inspector=w:new("Inspector","inspector")
  rejects(function()return inspector.v end,"inspection is available outside")
end)
return {passed=#results,tests=results}

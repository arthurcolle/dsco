@@
 static int hrt_cmp(const void *a, const void *b) {
     float sa = ((const hrt_score_t *)b)->score - ((const hrt_score_t *)a)->score;
     return sa > 0 ? 1 : sa < 0 ? -1 : 0;
 }
+
+/* expandify: prior-weighted, cost-normalized tool expansion policy.
+ *
+ * Runtime C version:
+ *   score = ((Q + c*P*sqrt(N)/(1+n)) * info * fertility * reversibility) / cost
+ *
+ * P is the retrieval prior (embedding/TF-IDF similarity). Q/cost/info/fertility
+ * are derived from the executable tool definition. This biases dynamic tool
+ * paging toward cheap, reversible, sibling-repricing probes (read/search/schema)
+ * and away from mutating/interactive tools unless evidence is strong.
+ */
+static float tool_name_has(const char *name, const char *needle) {
+    return (name && needle && strstr(name, needle)) ? 1.0f : 0.0f;
+}
+
+static float tool_expandify_score(const tool_def_t *t, float prior, float parent_visits,
+                                  float child_visits) {
+    if (!t)
+        return prior;
+    if (prior < 0.0f)
+        prior = 0.0f;
+    if (prior > 1.0f)
+        prior = 1.0f;
+    if (parent_visits < 1.0f)
+        parent_visits = 1.0f;
+
+    const float exploration = 1.4f;
+    float q = 0.0f, cost = 1.0f, info = 1.0f, fertility = 1.0f, reversibility = 1.0f;
+
+    if (t->core) { q += 0.05f; cost *= 0.85f; }
+    if (t->is_read_only) { q += 0.10f; info *= 1.35f; }
+    else { cost *= 4.0f; reversibility = 0.25f; }
+    if (t->is_concurrent) cost *= 0.80f;
+    if (t->is_interactive) cost *= 6.0f;
+
+    if (tool_name_has(t->name, "grep") || tool_name_has(t->name, "search") ||
+        tool_name_has(t->name, "find") || tool_name_has(t->name, "discover") ||
+        tool_name_has(t->name, "schema") || tool_name_has(t->name, "symbol") ||
+        tool_name_has(t->name, "ast") || tool_name_has(t->name, "include")) {
+        info *= 1.50f;
+        fertility *= 1.25f;
+    }
+    if (tool_name_has(t->name, "read") || tool_name_has(t->name, "list"))
+        info *= 1.20f;
+    if (tool_name_has(t->name, "write") || tool_name_has(t->name, "edit") ||
+        tool_name_has(t->name, "append") || tool_name_has(t->name, "bash") ||
+        tool_name_has(t->name, "run_command")) {
+        cost *= 1.50f;
+        reversibility *= 0.60f;
+    }
+    if (!t->is_read_only && prior < 0.25f)
+        reversibility *= 0.25f;
+
+    if (cost < 0.01f)
+        cost = 0.01f;
+    float u = exploration * prior * sqrtf(parent_visits) / (1.0f + child_visits);
+    return ((q + u) * info * fertility * reversibility) / cost;
+}
 
 int tools_retrieve(const char *context, int *out_indices, int max_tools) {

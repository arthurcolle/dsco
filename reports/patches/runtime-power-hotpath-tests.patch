+static void test_tools_get_core_count_cached(void) {
+    TEST("tools_get_core_count cached & stable");
+    tools_init();
+    int a = tools_get_core_count();
+    int b = tools_get_core_count();
+    ASSERT(a > 0, "core count positive");

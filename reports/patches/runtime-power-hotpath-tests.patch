+    ASSERT(!dsco_tool_is_interactive("nonexistent_tool_xyz"), "unknown not interactive");
+    ASSERT(!dsco_tool_is_interactive(""), "empty not interactive");
+    ASSERT(!dsco_tool_is_interactive(NULL), "null not interactive");

# Copy to .env and fill in what you use. docker-compose.yml reads this file;
# k8s reads the equivalent values from a Secret (see k8s/base/secret.example.yaml).

# --- run mode --------------------------------------------------------------
# mcp | acp | timeline | swarmd | repl — see docker/entrypoint.sh for details.
DSCO_MODE=mcp
DSCO_TOOLSETS=
DSCO_TIER=agent
# Set to make the container reachable from outside its own network namespace
# (compose: published as the host port below; k8s: the Service's targetPort).
DSCO_BIND_PORT=8765
DSCO_TIMELINE_PORT=8421

# --- provider credentials (set only the ones you actually use) -------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
FUGU_API_KEY=
CEREBRAS_API_KEY=
COHERE_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
MOONSHOT_API_KEY=
TOGETHER_API_KEY=
XAI_API_KEY=

# --- optional tool integrations ---------------------------------------------
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPAPI_API_KEY=
JINA_API_KEY=

# --- trading tools (only if you actually enable those toolsets) ------------
KALSHI_API_KEY=
KALSHI_RSA_PRIVATE_KEY_PATH=

# --- Linux/container note ---------------------------------------------------
# dsco's sealed secret store (src/se_store.c) has three tiers — Secure
# Enclave, macOS Keychain, and IOKit machine-UUID — and all three are
# Darwin-only. In this container they will fail closed by design; dsco falls
# back to reading credentials from plain environment variables above, which
# is also the documented default access pattern on every platform. No action
# needed — this is expected, not a bug.

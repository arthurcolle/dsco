{
  "name": "@distributed.systems/dsco-sdk",
  "version": "1.1.0",
  "description": "Typed client SDK for the dsco runtime: MCP tool plane + ACP session plane over a bundled, capability-governed binary.",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": { ".": { "import": "./src/index.js", "types": "./src/index.d.ts" } },
  "files": ["src", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "license": "MIT",
  "peerDependenciesMeta": {
    "@distributed.systems/dsco": { "optional": true }
  },
  "scripts": {
    "test:unit": "node --test test/unit.test.mjs",
    "test:e2e": "DSCO_BIN=$(cd ../.. && pwd)/dsco node --test test/e2e.test.mjs"
  }
}

          "else": {
            "properties": {
              "commit_id": false,
              "changes": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_type": {
                "const": "cursor_gap"
              }
            }
          },
          "then": {
            "required": [
              "error"
            ],
            "properties": {
              "error": {
                "properties": {
                  "code": {
                    "const": "CURSOR_GAP"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_type": {
                "const": "authority_revoked"
              }
            }
          },
          "then": {
            "required": [
              "error"
            ],
            "properties": {
              "error": {
                "properties": {
                  "code": {
                    "const": "UNAUTHORIZED"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_type": {
                "const": "keepalive"
              }
            }
          },
          "then": {
            "properties": {
              "error": false,
              "reset_snapshot": false
            }
          }
        }

          "$ref": "#/$defs/Error"
        },
        "reset_snapshot": {
          "type": "string",
          "minLength": 1,
          "description": "Optional advisory identifier of a possible replacement snapshot. It is not a new context or lease, does not guarantee availability, and must not advance a pinned view."
        },

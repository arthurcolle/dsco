        "backend_generation",
        "authorization_epoch",
        "cursor",
        "previous_cursor",
        "event_type",
        "observed_at"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "event_type": {
                "const": "committed_batch"
              }
            }
          },
          "then": {
            "required": [
              "commit_id",
              "changes"
